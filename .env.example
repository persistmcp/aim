# Supabase Postgres connection (transaction pooler, port 6543, for serverless).
# Get from Supabase dashboard → Project Settings → Database → Connection pooling (Transaction).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Public base URL of the deployment. Used by scripts/create_user.py to print connect URLs and by
# the signup flow to build the magic-link UI + MCP URLs in the email.
PUBLIC_BASE_URL=https://workout-storage.vercel.app

# Resend (https://resend.com) — sends the signup magic-link email. If unset, signup still creates
# the account but the email send is a logged no-op. EMAIL_FROM must use a domain verified in Resend
# to deliver to arbitrary inboxes (test mode only delivers to your own Resend account address).
RESEND_API_KEY=
EMAIL_FROM=Workout <onboarding@resend.dev>

# Full-access Resend key — the inbound-email webhook carries no body, so inbound.py fetches it
# from GET /emails/receiving/{id}; the send-only RESEND_API_KEY gets a 401 there.
RESEND_ADMIN_API_KEY=

# Secret shared with Vercel Cron to authorize the backup endpoint.
CRON_SECRET=change-me

# Vercel Blob token for backups (auto-set by Vercel when Blob store is linked).
BLOB_READ_WRITE_TOKEN=

# MCP registry (registry.modelcontextprotocol.io) publisher identity for the com.aim-journal/*
# namespace, proven via DNS TXT record on aim-journal.com. See
# .claude/skills/mcp-registry-publish/SKILL.md to regenerate if lost.
MCP_PUBLISHER_DOMAIN=aim-journal.com
MCP_PUBLISHER_PRIVATE_KEY=

# Telegram DM sent on every failed MCP tool call (owner-only alerting). Bot token from @BotFather;
# chat id is whoever DMed the bot (see docs/DEPLOYMENT.md). If unset, no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
